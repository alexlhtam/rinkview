{
  "name": "@rinkview/tactics-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./style.css": "./dist/lib/style.css",
    "./source": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "lint": "npm exec --workspace @rinkview/web --offline -c \"cd ../../packages/tactics-board && eslint .\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
